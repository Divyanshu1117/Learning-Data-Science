l = [3, 5, 6, 67];


for item in l:
    print(item);


for i in range(10):
    print(i);


for i in range(1, 10):
    print(i);


# While Loop.
i = 0;
while (i < 12):
    print(i);
    i = i + 1;


# Loop Control Statements.
for item in l:
    pass; # Dont't do anything.
    print("Hello");


l = ["Apples", "Bananas", "Tomatoes"];
for item in l:
    if(item == "Bananas"):
       break; # Stop this loop right here.
    print(item);


l = ["Apples", "Bananas", "Tomatoes"];
for item in l:
    if(item == "Bananas"):
       continue; # Skip this particular iteration of the loop.
    print(item);
