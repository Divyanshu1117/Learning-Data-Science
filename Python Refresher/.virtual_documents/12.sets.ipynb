# Set Operations.
set1 = {1, 2, 3, 4};
set2 = {3, 4, 5, 6};


# Union.
print(set1 | set2);


# Intersetion.
print(set1 & set2);


# Difference.
print(set1 - set2);


# Symmetric Difference.
print(set1 ^ set2);


# Issubset.
sub = {1, 3};


sub.issubset(set1)


# Issuperset.
set1.issubset(sub)
