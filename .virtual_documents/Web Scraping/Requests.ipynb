import requests;


a = requests.get("https://books.toscrape.com/");


with open(r"D:\Learning Data Science\Web Scraping\HTML'S\page1.html", "w") as f:
    f.write(a.text);


for i in range(1, 51):
    a = requests.get(f"https://books.toscrape.com/catalogue/page-{i}.html");
    with open(f"D:\Learning Data Science\Web Scraping\HTML'S\page{i}.html", "w", encoding = "utf-8") as f:
        f.write(a.text);
        print(f"Downloaded page {i} successfully");
